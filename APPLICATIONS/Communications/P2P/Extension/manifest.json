{
  "manifest_version": 3,
  "name": "P2P Mesh - Espace Collaboratif Décentralisé",
  "version": "1.0.0",
  "description": "Plateforme collaborative 100% Peer-to-Peer : Chatrooms, Forums répliqués, Drive partagé avec versioning, et Appels Audio/Vidéo Mesh sans serveur.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ouvrir P2P Mesh Workspace"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "sidePanel",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "notifications"
  ]
}
