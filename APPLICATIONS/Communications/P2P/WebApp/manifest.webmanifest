{
  "name": "P2P Mesh — Espace Collaboratif Décentralisé",
  "short_name": "P2P Mesh",
  "description": "Chat, forum, drive et salons vocaux/vidéo 100% pair-à-pair, chiffrés de bout en bout, sans serveur central.",
  "id": "/?pwa=1",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0a0d14",
  "theme_color": "#0a0d14",
  "lang": "fr",
  "dir": "ltr",
  "categories": ["social", "productivity", "communication"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+p2pmesh",
      "url": "./index.html?action=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Messagerie Instantanée",
      "short_name": "Chat",
      "description": "Accéder directement au chat chiffré P2P",
      "url": "./index.html#chat",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Drive & Documents P2P",
      "short_name": "Drive",
      "description": "Accéder aux documents partagés et versionnés",
      "url": "./index.html#drive",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Salons Vocaux & Vidéo",
      "short_name": "Salons",
      "description": "Rejoindre les salons WebRTC temps réel",
      "url": "./index.html#media",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "icons/icon-16.png",  "sizes": "16x16",   "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-32.png",  "sizes": "32x32",   "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-48.png",  "sizes": "48x48",   "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-128.png", "sizes": "128x128", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Espace de travail collaboratif décentralisé P2P Mesh sur grand écran"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Messagerie et Drive chiffrés sur mobile"
    }
  ]
}
